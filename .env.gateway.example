# gateway デーモンの設定の雛形。
# ★秘密は入っていない。**ここに鍵を書かないこと。**
#   bootstrap.sh がこれを .env.gateway にコピーする。
#   機械ごとに変えたいものだけ、コピーした側で直す。

# gateway デーモンの設定。
# ★ 既定の 8765 は obsidian_rsi/serve.py が先に使っているため 8775 にずらしてある。
#    実機のファームに焼く websocket.url も 8775 にすること。
WS_PORT=8775
CAPTURE_PORT=8776
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8767

# ★ VISION_HOST は空にしておく（gateway.sh が LAN IP を自動で拾う）。
#    ここが 127.0.0.1 のままだと、ESP32 が写真の受け口に届かず take_photo が失敗する。

# ★踊りの閾値。既定 0.35 は実機のマイクには厳しすぎた。
#   拍は取れているのにBPMが揺れて安定度が0になり、確信度が0.35に届かない。
#   vendor/stackchan-mcp/.../beat/mode.py をローカル改変して外から変えられるようにしてある。
STACKCHAN_BEAT_MIN_CONFIDENCE=0.12

# ── 聞き取り（STT）の設定。2026-09-12 実測で決めた ──────────────
# ★実機のマイクは遠い。声でもピーク 0.055 しかなく、そのままでは日本語が崩れた。
#   「ファームってなんですか」→「あー塗ってなんですか」
STACKCHAN_STT_VAD=1          # 無音を捨てる（8秒中2秒しか喋っていない）
STACKCHAN_STT_BEAM=5         # 精度優先
STACKCHAN_STT_NORMALIZE=1    # 音量を持ち上げてから渡す
# ★当日の語彙を先に教える。これが一番効いた（→「ファームってなんですか」で一致）
STACKCHAN_STT_PROMPT=スタックチャン,ファーム,ファームウェア,バックアップ,アンバインド,ゲートウェイ,エージェント,クロードコード,LED,DJ,テープ,人格,プロンプト,ラズパイ,ESP32
STACKCHAN_STT_DEBUG_WAV=1
STACKCHAN_TRACE_FRAMES=1
