diff --git a/gateway/stackchan_mcp/beat/mode.py b/gateway/stackchan_mcp/beat/mode.py
index 1406cb1..1f54bd2 100644
--- a/gateway/stackchan_mcp/beat/mode.py
+++ b/gateway/stackchan_mcp/beat/mode.py
@@ -36,7 +36,14 @@ LISTEN_STOP_TIMEOUT_S = 3.0
 LISTEN_RESTART_AFTER_S = 2.5
 LISTEN_RESTART_INITIAL_BACKOFF_S = 1.0
 LISTEN_RESTART_MAX_BACKOFF_S = 8.0
-MIN_MOTION_CONFIDENCE = 0.35
+# --- stackchan-lab のローカル改変 ---------------------------------------
+# 既定の 0.35 は「BPMが安定していること」を強く要求する。
+# 実機のマイクで拾った音は、拍は取れてもBPMが揺れやすく（99→84→79）、
+# 安定度が0に近くなって確信度が0.35に届かない＝一度も踊らない。
