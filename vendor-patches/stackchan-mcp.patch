+def _frame_level(frame: bytes) -> float:
+    """Opus 1フレームの音量（RMS 0..1）。
+
+    ★最初「圧縮後の長さ」で推測しようとしたが、**根拠が無い**（可変ビットレート
+      とは限らない）。ちゃんとデコードして測る。1フレーム60ms＝960サンプルなので、
+      毎秒16回デコードしても負荷は無視できる。
+    ★閾値（endpoint.SPEECH_LEVEL）は実測の RMS から決めてある。単位を揃える。
+    """
+    global _LEVEL_DECODER
+    import array
+    import opuslib
+
+    if _LEVEL_DECODER is None:
+        _LEVEL_DECODER = opuslib.Decoder(DEVICE_SAMPLE_RATE, 1)
+    pcm = _LEVEL_DECODER.decode(frame, int(DEVICE_SAMPLE_RATE
+                                           * DEVICE_FRAME_DURATION_MS / 1000))
+    a = array.array("h")
+    a.frombytes(pcm)
+    if not a:
+        return 0.0
+    return (sum(x * x for x in a) / len(a)) ** 0.5 / 32768.0
