+                 if (a / "app" / "dj" / "endpoint.py").exists()), None)
+    if root is None:
+        logger.warning("endpointer: app/dj/endpoint.py が見つからない。"
+                       "話し終わり検出は無効（時間で切ります）")
+        return None
+    try:
