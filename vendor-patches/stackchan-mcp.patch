+    def _normalize_pcm(pcm: bytes, target: float = 0.85, max_gain: float = 12.0) -> bytes:
+        """小さい音を持ち上げる。★実機のマイクは遠いので、そのままでは足りない。"""
+        import array
+        a = array.array("h")
+        a.frombytes(pcm[:len(pcm) // 2 * 2])
+        if not a:
+            return pcm
+        peak = max(abs(x) for x in a)
+        if peak <= 0:
+            return pcm
+        gain = min(max_gain, target * 32767 / peak)
+        if gain <= 1.05:
+            return pcm
+        lim = 32767
+        for i, x in enumerate(a):
+            v = int(x * gain)
+            a[i] = lim if v > lim else (-lim if v < -lim else v)
+        return a.tobytes()
+
