diff --git a/firmware/main/boards/common/usb_wired.cc b/firmware/main/boards/common/usb_wired.cc
new file mode 100644
index 0000000..a88682e
--- /dev/null
+++ b/firmware/main/boards/common/usb_wired.cc
@@ -0,0 +1,253 @@
+#include "usb_wired.h"
+#include "settings.h"
+#include "sdkconfig.h"
+
+#if CONFIG_TINYUSB_NET_MODE_NCM   // スタックチャンのビルドだけ（boards/stackchan/config.json）
+
+#include <cstdlib>
+#include <cstring>
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <esp_netif.h>
+#include <esp_netif_net_stack.h>
+#include <esp_timer.h>
+#include <esp_event.h>
+#include <lwip/netif.h>
+#include <lwip/tcpip.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <lwip/ip4_addr.h>
+#include <dhcpserver/dhcpserver.h>
+#include <dhcpserver/dhcpserver_options.h>
+
+#include "hal/usb_serial_jtag_ll.h"
+#include "tinyusb.h"
+#include "tinyusb_net.h"
+
+#define TAG "UsbWired"
+
+namespace UsbWired {
+namespace {
+
+esp_netif_t* s_netif = nullptr;
+volatile bool s_active = false;
+volatile uint32_t s_client_ip = 0;   // Mac に配った番地（ネットワークバイト順）
+int64_t s_start_us = 0;          // Start() を呼んだ時刻
+int64_t s_first_ready_us = 0;    // 初めて Mac に認識された時刻
+const char* s_result = "off";    // off / wired / wifi_fallback / install_failed
+std::function<void(bool)> s_on_change;
+
+// TinyUSB → lwIP。TinyUSB は受信バッファを使い回すので写してから渡す
+esp_err_t OnRecv(void* buffer, uint16_t len, void*) {
+    if (s_netif == nullptr) {
+        return ESP_OK;
+    }
+    void* copy = malloc(len);
+    if (copy == nullptr) {
+        return ESP_ERR_NO_MEM;
+    }
+    memcpy(copy, buffer, len);
+    return esp_netif_receive(s_netif, copy, len, nullptr);
+}
+
+// lwIP → TinyUSB。send_sync は TinyUSB 側に写し終えてから戻る
+esp_err_t Transmit(void*, void* buffer, size_t len) {
+    return tinyusb_net_send_sync(buffer, len, nullptr, pdMS_TO_TICKS(100));
+}
+
+void FreeRx(void*, void* buffer) {
+    free(buffer);
+}
+
+// Mac の Wi-Fi 側の番地（写真の受け口など）にも届くよう、経路を Mac に向ける
+void SetGwOnTcpip(void*) {
+    struct netif* n = (struct netif*)esp_netif_get_netif_impl(s_netif);
+    ip4_addr_t gw;
+    gw.addr = s_client_ip;
+    netif_set_gw(n, &gw);
+}
+
+// 実機の DHCP サーバが Mac に番地を配った
+void OnAssigned(void*, esp_event_base_t, int32_t, void* data) {
+    auto* e = static_cast<ip_event_ap_staipassigned_t*>(data);
+    if (e->esp_netif != s_netif) {
+        return;
+    }
+    s_client_ip = e->ip.addr;
+    tcpip_callback(SetGwOnTcpip, nullptr);
+    ESP_LOGI(TAG, "Mac got " IPSTR " over USB", IP2STR(&e->ip));
+}
+
+bool Ready() {
+    return tud_ready() && s_client_ip != 0;
+}
+
+void CreateNetif() {
+    esp_netif_init();
+
+    esp_netif_ip_info_t ip = {};
+    ip.ip.addr = ESP_IP4TOADDR(192, 168, 7, 2);
+    ip.gw.addr = 0;                                   // Mac に番地を配ったら、そこに向ける（OnAssigned）
+    ip.netmask.addr = ESP_IP4TOADDR(255, 255, 255, 0);
+
+    esp_netif_inherent_config_t base = ESP_NETIF_INHERENT_DEFAULT_ETH();
+    base.flags = (esp_netif_flags_t)(ESP_NETIF_DHCP_SERVER | ESP_NETIF_FLAG_AUTOUP);
+    base.ip_info = &ip;
+    base.if_key = "USB_NCM";
+    base.if_desc = "usb ncm";
+    base.route_prio = 200;                            // Wi-Fi（100）より優先
+
+    esp_netif_driver_ifconfig_t driver = {};
+    driver.handle = (void*)1;
+    driver.transmit = Transmit;
+    driver.driver_free_rx_buffer = FreeRx;
+
+    esp_netif_config_t cfg = {};
+    cfg.base = &base;
+    cfg.driver = &driver;
+    cfg.stack = ESP_NETIF_NETSTACK_DEFAULT_ETH;
+    s_netif = esp_netif_new(&cfg);
+    esp_event_handler_register(IP_EVENT, IP_EVENT_AP_STAIPASSIGNED, OnAssigned, nullptr);
+
+    uint8_t mac[6];
+    esp_read_mac(mac, ESP_MAC_ETH);
+    esp_netif_set_mac(s_netif, mac);
+
+    // ★先に netif を上げる（DHCP サーバが動き出す）。止めてから設定し、もう一度動かす
+    //   （逆順だと esp_netif_dhcps_option が「止まっていない」で弾かれる）
+    esp_netif_action_start(s_netif, nullptr, 0, nullptr);
+    esp_netif_action_connected(s_netif, nullptr, 0, nullptr);
+
+    // 経路（ルータ）は配らない＝Mac のネットは Wi-Fi のまま
+    ESP_ERROR_CHECK_WITHOUT_ABORT(esp_netif_dhcps_stop(s_netif));
+    dhcps_offer_t no_router = 0;
+    ESP_ERROR_CHECK_WITHOUT_ABORT(esp_netif_dhcps_option(s_netif, ESP_NETIF_OP_SET, ESP_NETIF_ROUTER_SOLICITATION_ADDRESS, &no_router, sizeof(no_router)));
+    ESP_ERROR_CHECK_WITHOUT_ABORT(esp_netif_dhcps_start(s_netif));
+}
+
+// 抜けた／挿さったを見張る
+void WatchTask(void*) {
+    while (true) {
+        bool ready = Ready();
+        if (ready && s_first_ready_us == 0) {
+            s_first_ready_us = esp_timer_get_time();
+        }
+        if (s_active && !ready) {
+            ESP_LOGW(TAG, "USB LAN disconnected");
+            s_active = false;
+            if (s_on_change) {
+                s_on_change(false);
+            }
+        } else if (!s_active && ready) {
+            ESP_LOGI(TAG, "USB LAN connected again");
+            s_active = true;
+            esp_netif_set_default_netif(s_netif);
+            if (s_on_change) {
+                s_on_change(true);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(500));
+    }
+}
+
+}  // namespace
+
+bool Enabled() {
+    Settings settings("network", false);
+    return settings.GetInt("usb", 0) == 1;
+}
+
+bool Start(int timeout_ms, std::function<void(bool up)> on_change) {
+    s_on_change = std::move(on_change);
+    s_start_us = esp_timer_get_time();
+
+    tinyusb_config_t tusb_cfg = {};
+    tusb_cfg.external_phy = false;
+    if (tinyusb_driver_install(&tusb_cfg) != ESP_OK) {
+        s_result = "install_failed";
+        ESP_LOGE(TAG, "tinyusb_driver_install failed");
+        return false;
+    }
+
+    // Mac から見える側の MAC（実機の MAC から作る。毎回同じ＝Mac の設定も毎回同じ）
+    tinyusb_net_config_t net_cfg = {};
+    esp_read_mac(net_cfg.mac_addr, ESP_MAC_ETH);
+    net_cfg.mac_addr[5] ^= 0x01;
+    net_cfg.on_recv_callback = OnRecv;
+    if (tinyusb_net_init(TINYUSB_USBDEV_0, &net_cfg) != ESP_OK) {
+        ESP_LOGE(TAG, "tinyusb_net_init failed");
+        return false;
+    }
+
+    CreateNetif();
+
+    ESP_LOGI(TAG, "Waiting for the Mac on USB (up to %d ms)", timeout_ms);
+    for (int waited = 0; waited < timeout_ms; waited += 200) {
+        if (Ready()) {
+            s_first_ready_us = esp_timer_get_time();
+            s_result = "wired";
+            s_active = true;
+            esp_netif_set_default_netif(s_netif);
+            ESP_LOGI(TAG, "USB LAN up: %s", WebsocketUrl().c_str());
+            xTaskCreate(WatchTask, "usb_wired", 3072, nullptr, 3, nullptr);
+            return true;
+        }
+        vTaskDelay(pdMS_TO_TICKS(200));
+    }
+    s_result = "wifi_fallback";
+    ESP_LOGW(TAG, "No Mac on USB. Falling back to Wi-Fi");
+    xTaskCreate(WatchTask, "usb_wired", 3072, nullptr, 3, nullptr);
+    return false;
+}
+
+bool Active() {
+    return s_active;
+}
+
+void RestoreSerial() {
+    usb_serial_jtag_ll_phy_enable_external(false);   // 内蔵 PHY を USB-Serial-JTAG へ
+}
+
+static std::string ClientIp() {
+    esp_ip4_addr_t a;
+    a.addr = s_client_ip;
+    char buf[16];
+    snprintf(buf, sizeof(buf), IPSTR, IP2STR(&a));
+    return buf;
+}
+
+std::string OtaUrl() {
+    return "http://" + ClientIp() + ":8778/";
+}
+
+std::string WebsocketUrl() {
+    return "ws://" + ClientIp() + ":8775/";
+}
+
+void AddStatus(cJSON* network) {
+    auto o = cJSON_CreateObject();
+    cJSON_AddBoolToObject(o, "enabled", Enabled());
+    cJSON_AddBoolToObject(o, "active", s_active);
+    cJSON_AddBoolToObject(o, "mounted", tud_mounted());
+    cJSON_AddStringToObject(o, "boot_result", s_result);
+    cJSON_AddStringToObject(o, "mac_ip", s_client_ip ? ClientIp().c_str() : "");
+    cJSON_AddNumberToObject(o, "ready_after_ms",
+                            s_first_ready_us ? (double)((s_first_ready_us - s_start_us) / 1000) : -1);
+    cJSON_AddItemToObject(network, "usb_wired", o);
+}
+
+}  // namespace UsbWired
+
+#else  // CONFIG_TINYUSB_NET_MODE_NCM ── 他のボードでは何もしない
+
+namespace UsbWired {
+bool Enabled() { return false; }
+bool Start(int, std::function<void(bool)>) { return false; }
+bool Active() { return false; }
+void RestoreSerial() {}
+void AddStatus(cJSON*) {}
+std::string OtaUrl() { return ""; }
+std::string WebsocketUrl() { return ""; }
+}  // namespace UsbWired
+
+#endif
diff --git a/firmware/main/boards/common/usb_wired.h b/firmware/main/boards/common/usb_wired.h
new file mode 100644
index 0000000..ffa2692
--- /dev/null
+++ b/firmware/main/boards/common/usb_wired.h
@@ -0,0 +1,42 @@
+// USB ケーブルを有線 LAN にする（stackchan-lab 2026-09-29）。
+//
+// NVS の network.usb が 1 のとき、起動時に USB を CDC-NCM（macOS は標準で認識する
+// USB LAN アダプタ）として出す。Mac に挿さっていれば、Wi-Fi を使わずに gateway へ繋ぐ。
+//   実機: 192.168.7.2   Mac: 実機の DHCP サーバが配った番地（192.168.7.x）
+//   接続先は「Mac に配った番地」: OTA http://<それ>:8778/  WebSocket ws://<それ>:8775/
+//   ★番地を決め打ちしない。Mac は前にもらった番地を覚えていて、それを頼んでくる（2026-09-29 実機で確認）
+// 15 秒待って Mac が見えなければ、今までどおり Wi-Fi で繋ぐ。
+// network.usb が無い／0 なら何もしない（今までと同じ動き・USB シリアルも生きている）。
+//
+// ★会場の Wi-Fi が 5GHz だけでも、ログイン画面つきでも、実機は繋がる。
+// ★USB を LAN にしている間は、USB シリアル（ログ・esptool の自動リセット）は使えない。
+#pragma once
+
+#include <functional>
+#include <string>
+#include <cJSON.h>
+
+namespace UsbWired {
+
+// USB の LAN の向こうの Mac に繋ぐ URL（Active() のときだけ意味がある）
+std::string OtaUrl();
+std::string WebsocketUrl();
+
+// NVS の network.usb が 1 か
+bool Enabled();
+
+// USB を シリアル（USB-Serial-JTAG）に戻す。USB を LAN にした後の再起動用。
+// ★USB の割り当ては RTC 側のレジスタにあり、ソフトの再起動では戻らない（2026-09-29 実機で確認）
+void RestoreSerial();
+
+// USB を LAN として出し、Mac に認識されて番地を配り終えるまで最大 timeout_ms 待つ。
+// 認識されたら true。on_change は、後で抜けた(false)／挿し直した(true)ときに呼ばれる。
+bool Start(int timeout_ms, std::function<void(bool up)> on_change);
+
+// いま USB の LAN で繋がっているか（接続先の差し替えに使う）
+bool Active();
+
+// get_device_info の network に usb_wired を足す（USB を LAN にしている間はシリアルのログが見えないため）
+void AddStatus(cJSON* network);
+
+}  // namespace UsbWired
