+def _make_endpointer(duration_ms: int):
+    """話し終わり検出。環境変数で切れる（STACKCHAN_STT_ENDPOINT=0）。"""
+    if os.environ.get("STACKCHAN_STT_ENDPOINT", "1") == "0":
+        return None
+    # ★パスを数えない。**探す。**
+    #   最初 parents[4] と数えて1つずれ、黙って無効になっていた（2026-09-12）。
+    #   しかも失敗を握りつぶしていたので、丸一手番気づけなかった。
+    here = Path(__file__).resolve()
+    root = next((a for a in here.parents
+                 if (a / "app" / "dj" / "endpoint.py").exists()), None)
+    if root is None:
+        logger.warning("endpointer: app/dj/endpoint.py が見つからない。"
+                       "話し終わり検出は無効（時間で切ります）")
+        return None
+    try:
+        sys.path.insert(0, str(root / "app" / "dj"))
+        from endpoint import Endpointer
+    except Exception as exc:
+        logger.warning("endpointer を読み込めない: %s（時間で切ります）", exc)
+        return None
+    return Endpointer(
+        silence_s=float(os.environ.get("STACKCHAN_STT_SILENCE_S", "0.8")),
+        min_speech_s=float(os.environ.get("STACKCHAN_STT_MIN_SPEECH_S", "0.3")),
+        max_s=duration_ms / 1000.0,
+        # ★合図から話し出すまで待つ。ここが短いと、余韻で切れて何も録れない
+        min_total_s=float(os.environ.get("STACKCHAN_STT_MIN_TOTAL_S", "2.5")),
+    )
+
+
+_LEVEL_DECODER = None
+
+
+def _frame_level(frame: bytes) -> float:
+    """Opus 1フレームの音量（RMS 0..1）。
+
+    ★最初「圧縮後の長さ」で推測しようとしたが、**根拠が無い**（可変ビットレート
+      とは限らない）。ちゃんとデコードして測る。1フレーム60ms＝960サンプルなので、
+      毎秒16回デコードしても負荷は無視できる。
+    ★閾値（endpoint.SPEECH_LEVEL）は実測の RMS から決めてある。単位を揃える。
+    """
+    global _LEVEL_DECODER
+    import array
+    import opuslib
+
+    if _LEVEL_DECODER is None:
+        _LEVEL_DECODER = opuslib.Decoder(DEVICE_SAMPLE_RATE, 1)
+    pcm = _LEVEL_DECODER.decode(frame, int(DEVICE_SAMPLE_RATE
+                                           * DEVICE_FRAME_DURATION_MS / 1000))
+    a = array.array("h")
+    a.frombytes(pcm)
+    if not a:
+        return 0.0
+    return (sum(x * x for x in a) / len(a)) ** 0.5 / 32768.0
+
