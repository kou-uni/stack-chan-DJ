# ── 環境・秘密 ────────────────────────────────
.venv/
.env
.env.gateway
server/.env
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.coverage

# ── 外部のもの（配布元から取り直せる）──────────────
# ★ただし vendor/stackchan-mcp にはローカル改変がある。
#   改変は docs/vendor-patches.md に記録し、パッチとして残す
vendor/
!vendor-patches/

# ── 大きいバイナリ ────────────────────────────
firmware/*.bin
firmware/*.zip
backup/*.bin

# ── 記録・作業ファイル ─────────────────────────
*.log
*.jsonl
server/data/
app/avatar/frames/
app/avatar/*.png
app/avatar/*.raw

# ファームのビルド作業場（数GB・生成物）
build/

# 台本の紙芝居（生成物。./scripts/build-text.sh で作り直せる）
event/text.html

# 当日の録音と文字起こし（★人の声。リポジトリに入れない）
event/rec/
